{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:grade9v3:gcdr-suite-contract:1.0.0",
  "title": "GCDR Suite Contract",
  "description": "Suite-level provenance, coverage and packaging contract for multi-rig/master-suite experiences.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "suite_id",
    "scope",
    "external_corpus",
    "diagnostic_item_refs",
    "activity_refs",
    "delivery_profiles"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "suite_id": {
      "type": "string",
      "minLength": 3
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_binding_status",
        "instructional_depth",
        "certification_scope"
      ],
      "properties": {
        "canonical_binding_status": {
          "enum": [
            "BOUND",
            "PARTIAL",
            "UNBOUND_EXTENSION"
          ]
        },
        "instructional_depth": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "FOUNDATION",
              "SCHOOL_CORE",
              "ADVANCED",
              "JEE_EXTENSION"
            ]
          }
        },
        "certification_scope": {
          "type": "string",
          "minLength": 10
        }
      }
    },
    "external_corpus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "topic",
        "snapshot_date",
        "live_count",
        "embedded_item_count",
        "coverage_claim"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 2
        },
        "topic": {
          "type": "string",
          "minLength": 2
        },
        "snapshot_date": {
          "type": "string",
          "format": "date"
        },
        "live_count": {
          "type": "integer",
          "minimum": 0
        },
        "embedded_item_count": {
          "type": "integer",
          "minimum": 0
        },
        "coverage_claim": {
          "enum": [
            "FULL_CORPUS_AUDITED",
            "CURATED_SLICE_AUDITED",
            "DEMAND_RECONNAISSANCE_ONLY"
          ]
        }
      }
    },
    "diagnostic_item_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "activity_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delivery_profiles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile",
          "artifact_locator",
          "external_dependencies"
        ],
        "properties": {
          "profile": {
            "enum": [
              "REPO_BUNDLE",
              "SINGLE_FILE_ONLINE",
              "SINGLE_FILE_OFFLINE"
            ]
          },
          "artifact_locator": {
            "type": "string",
            "minLength": 1
          },
          "external_dependencies": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
