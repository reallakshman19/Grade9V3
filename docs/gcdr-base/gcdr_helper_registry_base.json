      "required_outputs": [
        "observer",
        "axis",
        "relative_quantity"
      ]
    },
    {
      "id": "PHASE_TIMELINE",
      "role": "Piecewise-state continuity",
      "required_outputs": [
        "phases",
        "boundary_states",
        "continuity_checks"
      ]
    },
    {
      "id": "TANGENT_HELPER",
      "role": "Local derivative visual",
      "required_outputs": [
        "tangent_point",
        "slope",
        "derived_product"
      ]
    },
    {
      "id": "SOLUTION_LOCUS_HELPER",
      "role": "Underdetermined vector solution family",
      "required_outputs": [
        "particular_solution",
        "nullspace_direction",
        "free_parameter"
      ]
    },
    {
      "id": "BAC_CAB_HELPER",
      "role": "Vector triple product expansion",
      "required_outputs": [
